# ===================================================
# BU Resource Hub - Environment Configuration Template
# ===================================================

# --- Required for Web App & Vercel Deployment ---
# Your Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon / public key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Optional Configurations ---
# Comma-separated list of extra allowed origins for CORS (e.g. custom domains)
# Note: Vercel (*.vercel.app) and localhost are allowed by default
ALLOWED_ORIGINS=http://localhost:3000,https://resource-hub-gamma.vercel.app

# Server Port (used for local standalone Express server)
PORT=3000

# --- Required ONLY for running setup_db.js migration script locally ---
# Direct PostgreSQL connection string
DATABASE_URL=postgres://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
