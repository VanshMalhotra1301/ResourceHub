{
  "version": 2,
  "rewrites": [
    {
      "source": "/login",
      "destination": "/pages/auth/auth.html"
    },
    {
      "source": "/signup",
      "destination": "/pages/auth/signup.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/sem1",
      "destination": "/pages/semesters/sem1.html"
    },
    {
      "source": "/sem2",
      "destination": "/pages/semesters/sem2.html"
    },
    {
      "source": "/sem3",
      "destination": "/pages/semesters/sem3.html"
    },
    {
      "source": "/sem4",
      "destination": "/pages/semesters/sem4.html"
    },
    {
      "source": "/library",
      "destination": "/pages/library.html"
    },
    {
      "source": "/courses",
      "destination": "/pages/courses.html"
    },
    {
      "source": "/tools",
      "destination": "/pages/tools.html"
    },
    {
      "source": "/dsa",
      "destination": "/pages/dsa/visual-dsa.html"
    },
    {
      "source": "/os",
      "destination": "/pages/os/os-visual.html"
    },
    {
      "source": "/test",
      "destination": "/pages/auth/test_auth.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/login",
      "permanent": false
    }
  ]
}
