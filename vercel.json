{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["css/**", "js/**", "pages/**", "index.html", "logo.jpg", "skills.png"]
      }
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "pages/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "logo.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "skills.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/logo.jpg",
      "dest": "/logo.jpg"
    },
    {
      "src": "/skills.png",
      "dest": "/skills.png"
    },
    {
      "src": "/login",
      "dest": "/pages/auth/auth.html"
    },
    {
      "src": "/signup",
      "dest": "/pages/auth/signup.html"
    },
    {
      "src": "/home",
      "dest": "/index.html"
    },
    {
      "src": "/sem1",
      "dest": "/pages/semesters/sem1.html"
    },
    {
      "src": "/sem2",
      "dest": "/pages/semesters/sem2.html"
    },
    {
      "src": "/sem3",
      "dest": "/pages/semesters/sem3.html"
    },
    {
      "src": "/sem4",
      "dest": "/pages/semesters/sem4.html"
    },
    {
      "src": "/sem5",
      "dest": "/pages/semesters/sem5.html"
    },
    {
      "src": "/library",
      "dest": "/pages/library.html"
    },
    {
      "src": "/courses",
      "dest": "/pages/courses.html"
    },
    {
      "src": "/tools",
      "dest": "/pages/tools.html"
    },
    {
      "src": "/dsa",
      "dest": "/pages/dsa/visual-dsa.html"
    },
    {
      "src": "/dsa/visual-dsa.html",
      "dest": "/pages/dsa/visual-dsa.html"
    },
    {
      "src": "/visual-dsa.html",
      "dest": "/pages/dsa/visual-dsa.html"
    },
    {
      "src": "/dsa/(.*)",
      "dest": "/pages/dsa/$1"
    },
    {
      "src": "/dsa-(.*)",
      "dest": "/pages/dsa/dsa-$1"
    },
    {
      "src": "/os",
      "dest": "/pages/os/os-visual.html"
    },
    {
      "src": "/os/os-visual.html",
      "dest": "/pages/os/os-visual.html"
    },
    {
      "src": "/os-visual.html",
      "dest": "/pages/os/os-visual.html"
    },
    {
      "src": "/os/(.*)",
      "dest": "/pages/os/$1"
    },
    {
      "src": "/os-(.*)",
      "dest": "/pages/os/os-$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/pages/$1"
    },
    {
      "src": "/test",
      "dest": "/pages/auth/test_auth.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/login"
      }
    }
  ]
}
