{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "pages/**,css/**,js/**,index.html,logo.jpg,skills.png"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/login",
      "dest": "/pages/auth/auth.html"
    },
    {
      "src": "/signup",
      "dest": "/pages/auth/signup.html"
    },
    {
      "src": "/home",
      "dest": "/index.html"
    },
    {
      "src": "/sem1",
      "dest": "/pages/semesters/sem1.html"
    },
    {
      "src": "/sem2",
      "dest": "/pages/semesters/sem2.html"
    },
    {
      "src": "/sem3",
      "dest": "/pages/semesters/sem3.html"
    },
    {
      "src": "/sem4",
      "dest": "/pages/semesters/sem4.html"
    },
    {
      "src": "/library",
      "dest": "/pages/library.html"
    },
    {
      "src": "/courses",
      "dest": "/pages/courses.html"
    },
    {
      "src": "/tools",
      "dest": "/pages/tools.html"
    },
    {
      "src": "/dsa",
      "dest": "/pages/dsa/visual-dsa.html"
    },
    {
      "src": "/os",
      "dest": "/pages/os/os-visual.html"
    },
    {
      "src": "/test",
      "dest": "/pages/auth/test_auth.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/login"
      }
    }
  ]
}
